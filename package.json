{
  "name": "deepseek-companion-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test --experimental-test-coverage tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && node scripts/check-public-files.mjs",
    "dsh": "node scripts/dsh.mjs",
    "chat": "node scripts/chat.mjs",
    "qq": "node scripts/qq.mjs",
    "test:live": "node scripts/live-check.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:sdk": "node scripts/sdk-smoke.mjs",
    "pet:install": "node scripts/install-pet.mjs",
    "pet": "node scripts/dsh.mjs web --no-open --host 127.0.0.1 --port 3847",
    "pet:demo": "node scripts/pet-demo.mjs",
    "runtime:install": "node scripts/install-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
